{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/server/Dockerfile",
    "watchPatterns": [
      "apps/server/**",
      ".dockerignore"
    ]
  },
  "deploy": {
    "healthcheckPath": "/actuator/health",
    "healthcheckTimeout": 300
  }
}
