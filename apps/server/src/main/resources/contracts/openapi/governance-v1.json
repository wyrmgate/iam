  "components": {
    "parameters": {
      "RequestId": {
        "name": "requestId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ItemId": {
        "name": "itemId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ApprovalCaseId": {
        "name": "approvalCaseId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\\\"rev-[1-9][0-9]*\\\"$"
        }
      },
      "CorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      },
      "ReviewCampaignId": {
        "name": "campaignId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ReviewItemId": {
        "name": "reviewItemId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ReviewRemediationId": {
        "name": "remediationId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "headers": {
      "ETag": {
        "schema": {
          "type": "string",
          "pattern": "^\\\"rev-[1-9][0-9]*\\\"$"
        }
      },
      "CorrelationId": {
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "requestBodies": {
      "DecisionRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DecisionRequest"
            }
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Semantic error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ApprovalDecisionResult": {
        "description": "Updated approval evidence",
        "headers": {
          "ETag": {
            "$ref": "#/components/headers/ETag"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Approval"
            }
          }
        }
      }
    },
    "schemas": {
      "AccessRequestCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "beneficiaryIdentityId",
          "items"
        ],
        "properties": {
          "beneficiaryIdentityId": {
            "type": "string",
            "format": "uuid",
            "description": "Initial v1 surface permits only the authenticated governed Identity as beneficiary."
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/RequestItemInput"
            }
          }
        }
      },
      "RequestItemInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetKind",
          "targetId",
          "principalConstraintKind",
          "specificPrincipalId",
          "validFrom",
          "validUntil"
        ],
        "properties": {
          "targetKind": {
            "type": "string",
            "enum": [
              "ROLE",
              "ENTITLEMENT"
            ]
          },
          "targetId": {
            "type": "string",
            "format": "uuid"
          },
          "principalConstraintKind": {
            "type": "string",
