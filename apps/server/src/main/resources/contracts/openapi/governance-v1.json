{
  "openapi": "3.1.0",
  "info": {
    "title": "Wyrmgate IAM Governance API",
    "version": "1.0.0",
    "description": "Public Governance control-plane contract for self-service AccessRequest, reusable approval work, and IDENTITY_ACCESS review/certification."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
