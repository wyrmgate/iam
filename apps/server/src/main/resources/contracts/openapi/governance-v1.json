{
  "openapi": "3.1.2",
  "info": {
    "title": "Wyrmgate IAM Governance Approval API",
    "version": "0.1.0",
    "description": "Reusable Governance-owned human approval surface. Approval cases are opened by typed subject owners; authenticated resolved participants use one cross-subject inbox and explicit approve/reject operations. Approval never directly mutates subject authority."
  },
  "security": [
    {
      "controlPlaneBearer": []
    }
  ],
  "paths": {
    "/approval-inbox": {
      "get": {
        "operationId": "listApprovalInbox",
        "summary": "List current actionable approval work for the authenticated Identity",
        "description": "Returns only PENDING ApprovalCases where the authenticated governed Identity is a participant in the current stage and has not already decided that stage. Administrative permission is not a substitute for approval participation.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Approval inbox page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalInboxPage"
                }
              }
            }
          }
        },
        "x-wyrmgate-authority": "Governance approval orchestration",
        "x-wyrmgate-authorization": "Authenticated governed Identity must be a resolved current-stage participant."
      }
    },
    "/approval-cases/{approvalCaseId}/approve": {
      "post": {
        "operationId": "approveApprovalCase",
        "summary": "Approve current approval stage",
        "description": "Records immutable APPROVE evidence for the authenticated governed Identity. The actor must be a resolved participant in the current stage; requester self-decision remains governed by the immutable plan policy.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ApprovalCaseId"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "ApprovalCase advanced or completed",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/RevisionEtag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalCaseResource"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "412": {
            "$ref": "#/components/responses/StaleRevision"
          }
        },
        "x-wyrmgate-authority": "Governance approval orchestration",
        "x-wyrmgate-authorization": "Current-stage resolved participant; no administrative override.",
        "x-wyrmgate-idempotency": "Required"
      }
    },
    "/approval-cases/{approvalCaseId}/reject": {
      "post": {
        "operationId": "rejectApprovalCase",
        "summary": "Reject current approval stage",
        "description": "Records immutable REJECT evidence for the authenticated governed Identity. The actor must be a resolved participant in the current stage; requester self-decision remains governed by the immutable plan policy.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ApprovalCaseId"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "ApprovalCase advanced or completed",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/RevisionEtag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalCaseResource"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "412": {
            "$ref": "#/components/responses/StaleRevision"
          }
        },
        "x-wyrmgate-authority": "Governance approval orchestration",
        "x-wyrmgate-authorization": "Current-stage resolved participant; no administrative override.",
        "x-wyrmgate-idempotency": "Required"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "controlPlaneBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authentication is transport-level only; Administrative Authorization remains separately default-deny."
      }
    },
    "parameters": {
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Opaque signed tenant/context-bound time-bounded continuation cursor.",
        "schema": {
          "type": "string"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\\\"rev-[1-9][0-9]*\\\"$"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        }
      },
      "CorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ApprovalCaseId": {
        "name": "approvalCaseId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "headers": {
      "RevisionEtag": {
        "description": "Strong authoritative revision ETag.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Administrative authorization denied",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found in tenant",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Semantic/idempotency conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "StaleRevision": {
        "description": "Stale If-Match revision",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ApprovalSubjectType": {
        "type": "string",
        "enum": [
          "REQUEST_ITEM",
          "ADMINISTRATIVE_ELEVATION",
          "ROLE_VERSION_ACTIVATION",
          "POLICY_VERSION_ACTIVATION",
          "GOVERNANCE_EXCEPTION",
          "CREDENTIAL_OPERATION"
        ]
      },
      "ApprovalCaseLifecycleState": {
        "type": "string",
        "enum": [
          "PENDING",
          "APPROVED",
          "REJECTED",
          "CANCELLED",
          "SUPERSEDED"
        ]
      },
      "ApprovalDecisionMode": {
        "type": "string",
        "enum": [
          "ANY_ONE",
          "ALL"
        ]
      },
      "ApprovalCaseResource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subjectType",
          "subjectId",
          "subjectRevision",
          "lifecycleState",
          "currentStageOrdinal",
          "revision",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "subjectType": {
            "$ref": "#/components/schemas/ApprovalSubjectType"
          },
          "subjectId": {
            "type": "string",
            "format": "uuid"
          },
          "subjectRevision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "requesterIdentityId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "lifecycleState": {
            "$ref": "#/components/schemas/ApprovalCaseLifecycleState"
          },
          "currentStageOrdinal": {
            "type": "integer",
            "minimum": 0
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "ApprovalInboxItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approvalCase",
          "stageId",
          "decisionMode",
          "participantIdentityIds"
        ],
        "properties": {
          "approvalCase": {
            "$ref": "#/components/schemas/ApprovalCaseResource"
          },
          "stageId": {
            "type": "string",
            "format": "uuid"
          },
          "decisionMode": {
            "$ref": "#/components/schemas/ApprovalDecisionMode"
          },
          "participantIdentityIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "ApprovalInboxPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprovalInboxItem"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  },
  "x-wyrmgate-contract-status": "runtime-exposed-authenticated-participant-authorized"
}
