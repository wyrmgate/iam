{
  "openapi": "3.1.0",
  "info": {
    "title": "Wyrmgate IAM Governance API",
    "version": "1.0.0",
    "description": "Public Governance control-plane contract for self-service AccessRequest and reusable approval work."
  },
  "servers": [{"url": "/api/v1"}],
  "paths": {
    "/governance/access-requests": {
      "post": {
        "operationId": "createAccessRequest",
        "summary": "Create a draft access request",
        "parameters": [
          {"$ref": "#/components/parameters/IdempotencyKey"},
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AccessRequestCreate"}}}
        },
        "responses": {
          "201": {
            "description": "Created",
            "headers": {
              "ETag": {"$ref": "#/components/headers/ETag"},
              "X-Correlation-Id": {"$ref": "#/components/headers/CorrelationId"}
            },
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AccessRequest"}}}
          },
          "400": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/governance/access-requests/{requestId}": {
      "get": {
        "operationId": "getAccessRequest",
        "summary": "Read an access request and item status",
        "parameters": [
          {"$ref": "#/components/parameters/RequestId"},
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "responses": {
          "200": {
            "description": "Access request",
            "headers": {
              "ETag": {"$ref": "#/components/headers/ETag"},
              "X-Correlation-Id": {"$ref": "#/components/headers/CorrelationId"}
            },
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AccessRequest"}}}
          },
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/governance/access-requests/{requestId}/submit": {
      "post": {
        "operationId": "submitAccessRequest",
        "summary": "Submit a draft access request for durable Governance evaluation",
        "parameters": [
          {"$ref": "#/components/parameters/RequestId"},
          {"$ref": "#/components/parameters/IfMatch"},
          {"$ref": "#/components/parameters/IdempotencyKey"},
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "responses": {
          "200": {
            "description": "Submitted",
            "headers": {
              "ETag": {"$ref": "#/components/headers/ETag"},
              "X-Correlation-Id": {"$ref": "#/components/headers/CorrelationId"}
            },
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AccessRequest"}}}
          },
          "400": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"},
          "412": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/governance/request-items/{itemId}": {
      "get": {
        "operationId": "getRequestItem",
        "summary": "Read one request item status",
        "parameters": [
          {"$ref": "#/components/parameters/ItemId"},
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "responses": {
          "200": {
            "description": "Request item",
            "headers": {
              "ETag": {"$ref": "#/components/headers/ETag"},
              "X-Correlation-Id": {"$ref": "#/components/headers/CorrelationId"}
            },
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RequestItem"}}}
          },
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/governance/approval-inbox": {
      "get": {
        "operationId": "listApprovalInbox",
        "summary": "List pending current-stage approval work for the authenticated governed Identity",
        "parameters": [
          {"$ref": "#/components/parameters/Cursor"},
          {"$ref": "#/components/parameters/Limit"},
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "responses": {
          "200": {
            "description": "Approver inbox",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApprovalInboxPage"}}}
          },
          "400": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/governance/approvals/{approvalCaseId}": {
      "get": {
        "operationId": "getApprovalEvidence",
        "summary": "Read reusable approval case and immutable decision evidence",
        "parameters": [
          {"$ref": "#/components/parameters/ApprovalCaseId"},
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "responses": {
          "200": {
            "description": "Approval evidence",
            "headers": {"ETag": {"$ref": "#/components/headers/ETag"}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Approval"}}}
          },
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/governance/approvals/{approvalCaseId}/approve": {
      "post": {
        "operationId": "approveApprovalCase",
        "summary": "Approve the current reusable approval stage",
        "parameters": [
          {"$ref": "#/components/parameters/ApprovalCaseId"},
          {"$ref": "#/components/parameters/IfMatch"},
          {"$ref": "#/components/parameters/IdempotencyKey"},
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "requestBody": {"$ref": "#/components/requestBodies/DecisionRequest"},
        "responses": {
          "200": {"$ref": "#/components/responses/ApprovalDecisionResult"},
          "400": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"},
          "412": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/governance/approvals/{approvalCaseId}/reject": {
      "post": {
        "operationId": "rejectApprovalCase",
        "summary": "Reject the current reusable approval stage",
        "parameters": [
          {"$ref": "#/components/parameters/ApprovalCaseId"},
          {"$ref": "#/components/parameters/IfMatch"},
          {"$ref": "#/components/parameters/IdempotencyKey"},
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "requestBody": {"$ref": "#/components/requestBodies/DecisionRequest"},
        "responses": {
          "200": {"$ref": "#/components/responses/ApprovalDecisionResult"},
          "400": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"},
          "412": {"$ref": "#/components/responses/Error"}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "RequestId": {"name": "requestId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "ItemId": {"name": "itemId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "ApprovalCaseId": {"name": "approvalCaseId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 8, "maxLength": 200}},
      "IfMatch": {"name": "If-Match", "in": "header", "required": true, "schema": {"type": "string", "pattern": "^\\\"rev-[1-9][0-9]*\\\"$"}},
      "CorrelationId": {"name": "X-Correlation-Id", "in": "header", "required": false, "schema": {"type": "string", "format": "uuid"}},
      "Cursor": {"name": "cursor", "in": "query", "required": false, "schema": {"type": "string", "maxLength": 4096}},
      "Limit": {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 200, "default": 50}}
    },
    "headers": {
      "ETag": {"schema": {"type": "string", "pattern": "^\\\"rev-[1-9][0-9]*\\\"$"}},
      "CorrelationId": {"schema": {"type": "string", "format": "uuid"}}
    },
    "requestBodies": {
      "DecisionRequest": {
        "required": true,
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DecisionRequest"}}}
      }
    },
    "responses": {
      "Error": {
        "description": "Semantic error",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}
      },
      "ApprovalDecisionResult": {
        "description": "Updated approval evidence",
        "headers": {"ETag": {"$ref": "#/components/headers/ETag"}},
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Approval"}}}
      }
    },
    "schemas": {
      "AccessRequestCreate": {
        "type": "object",
        "additionalProperties": false,
        "required": ["beneficiaryIdentityId", "items"],
        "properties": {
          "beneficiaryIdentityId": {"type": "string", "format": "uuid", "description": "Initial v1 surface permits only the authenticated governed Identity as beneficiary."},
          "items": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/components/schemas/RequestItemInput"}}
        }
      },
      "RequestItemInput": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetKind", "targetId", "principalConstraintKind", "specificPrincipalId", "validFrom", "validUntil"],
        "properties": {
          "targetKind": {"type": "string", "enum": ["ROLE", "ENTITLEMENT"]},
          "targetId": {"type": "string", "format": "uuid"},
          "principalConstraintKind": {"type": "string", "enum": ["ANY", "SPECIFIC"]},
          "specificPrincipalId": {"type": ["string", "null"], "format": "uuid"},
          "validFrom": {"type": ["string", "null"], "format": "date-time"},
          "validUntil": {"type": ["string", "null"], "format": "date-time"}
        }
      },
      "AccessRequest": {
        "type": "object",
        "required": ["id", "requesterIdentityId", "beneficiaryIdentityId", "state", "revision", "createdAt", "updatedAt", "items"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "requesterIdentityId": {"type": "string", "format": "uuid"},
          "beneficiaryIdentityId": {"type": "string", "format": "uuid"},
          "state": {"type": "string", "enum": ["DRAFT", "SUBMITTED", "IN_PROGRESS", "COMPLETED", "CANCELLED", "EXPIRED"]},
          "revision": {"type": "integer", "format": "int64", "minimum": 1},
          "createdAt": {"type": "string", "format": "date-time"},
          "submittedAt": {"type": ["string", "null"], "format": "date-time"},
          "updatedAt": {"type": "string", "format": "date-time"},
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/RequestItem"}}
        }
      },
      "RequestItem": {
        "type": "object",
        "required": ["id", "accessRequestId", "targetKind", "principalConstraintKind", "state", "revision", "createdAt", "updatedAt"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "accessRequestId": {"type": "string", "format": "uuid"},
          "targetKind": {"type": "string", "enum": ["ROLE", "ENTITLEMENT"]},
          "roleId": {"type": ["string", "null"], "format": "uuid"},
          "entitlementId": {"type": ["string", "null"], "format": "uuid"},
          "principalConstraintKind": {"type": "string", "enum": ["ANY", "SPECIFIC"]},
          "specificPrincipalId": {"type": ["string", "null"], "format": "uuid"},
          "validFrom": {"type": ["string", "null"], "format": "date-time"},
          "validUntil": {"type": ["string", "null"], "format": "date-time"},
          "state": {"type": "string", "enum": ["DRAFT", "SUBMITTED", "EVALUATING", "PENDING_APPROVAL", "AUTHORIZED", "APPLIED", "DENIED", "REJECTED", "CANCELLED", "EXPIRED"]},
          "approvalCaseId": {"type": ["string", "null"], "format": "uuid"},
          "accessAssignmentId": {"type": ["string", "null"], "format": "uuid"},
          "evaluationCode": {"type": ["string", "null"]},
          "revision": {"type": "integer", "format": "int64", "minimum": 1},
          "createdAt": {"type": "string", "format": "date-time"},
          "updatedAt": {"type": "string", "format": "date-time"}
        }
      },
      "ApprovalInboxPage": {
        "type": "object",
        "required": ["items"],
        "properties": {
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/ApprovalSummary"}},
          "nextCursor": {"type": ["string", "null"]}
        }
      },
      "ApprovalSummary": {
        "type": "object",
        "required": ["id", "subjectKind", "subjectId", "state", "currentStageOrdinal", "revision", "createdAt", "updatedAt"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "subjectKind": {"type": "string"},
          "subjectId": {"type": "string", "format": "uuid"},
          "state": {"type": "string"},
          "currentStageOrdinal": {"type": "integer", "minimum": 0},
          "revision": {"type": "integer", "format": "int64", "minimum": 1},
          "createdAt": {"type": "string", "format": "date-time"},
          "updatedAt": {"type": "string", "format": "date-time"}
        }
      },
      "Approval": {
        "type": "object",
        "required": ["id", "subjectKind", "subjectId", "initiatorIdentityId", "state", "currentStageOrdinal", "revision", "createdAt", "updatedAt", "planId", "planNumber", "planCreatedAt", "stages"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "subjectKind": {"type": "string"},
          "subjectId": {"type": "string", "format": "uuid"},
          "initiatorIdentityId": {"type": "string", "format": "uuid"},
          "state": {"type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "CANCELLED", "SUPERSEDED"]},
          "currentStageOrdinal": {"type": "integer", "minimum": 0},
          "revision": {"type": "integer", "format": "int64", "minimum": 1},
          "createdAt": {"type": "string", "format": "date-time"},
          "updatedAt": {"type": "string", "format": "date-time"},
          "completedAt": {"type": ["string", "null"], "format": "date-time"},
          "planId": {"type": "string", "format": "uuid"},
          "planNumber": {"type": "integer", "format": "int64", "minimum": 1},
          "planCreatedAt": {"type": "string", "format": "date-time"},
          "stages": {"type": "array", "items": {"$ref": "#/components/schemas/ApprovalStage"}}
        }
      },
      "ApprovalStage": {
        "type": "object",
        "required": ["id", "ordinal", "decisionMode", "approvers", "decisions"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "ordinal": {"type": "integer", "minimum": 0},
          "decisionMode": {"type": "string", "enum": ["ANY_ONE", "ALL"]},
          "approvers": {"type": "array", "items": {"$ref": "#/components/schemas/ApprovalApprover"}},
          "decisions": {"type": "array", "items": {"$ref": "#/components/schemas/ApprovalDecision"}}
        }
      },
      "ApprovalApprover": {
        "type": "object",
        "required": ["approverIdentityId"],
        "properties": {"approverIdentityId": {"type": "string", "format": "uuid"}}
      },
      "ApprovalDecision": {
        "type": "object",
        "required": ["id", "approverIdentityId", "decision", "decidedAt"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "approverIdentityId": {"type": "string", "format": "uuid"},
          "decision": {"type": "string", "enum": ["APPROVE", "REJECT"]},
          "reason": {"type": ["string", "null"], "maxLength": 1000},
          "decidedAt": {"type": "string", "format": "date-time"}
        }
      },
      "DecisionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "properties": {"reason": {"type": ["string", "null"], "maxLength": 1000}}
      },
      "FieldError": {
        "type": "object",
        "required": ["field", "code", "message"],
        "properties": {
          "field": {"type": "string"},
          "code": {"type": "string"},
          "message": {"type": "string"}
        }
      },
      "Error": {
        "type": "object",
        "required": ["code", "message", "correlationId", "fieldErrors"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "correlationId": {"type": "string", "format": "uuid"},
          "fieldErrors": {"type": "array", "items": {"$ref": "#/components/schemas/FieldError"}}
        }
      }
    }
  }
}
