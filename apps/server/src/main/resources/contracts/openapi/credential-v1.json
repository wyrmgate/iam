{
  "openapi": "3.1.2",
  "info": {
    "title": "Wyrmgate IAM Credential API",
    "version": "0.1.0",
    "description": "Credential-owned authentication-instrument metadata and durable rotation control plane. SecretReference values are opaque external references only; this API never accepts, retrieves or returns raw secret/private material."
  },
  "security": [
    {
      "controlPlaneBearer": []
    }
  ],
  "paths": {
    "/credentials": {
      "get": {
        "operationId": "listCredentials",
        "summary": "List Credentials for one Principal",
        "parameters": [
          {
            "$ref": "#/components/parameters/PrincipalIdFilter"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/CredentialPageResponse"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "x-wyrmgate-authority": "Credential authoritative state",
        "x-wyrmgate-administrative-permission": "credential:read",
        "x-wyrmgate-pagination": "createdAt + id; signed tenant/principal-bound cursor"
      },
      "post": {
        "operationId": "createCredential",
        "summary": "Create governed Credential metadata",
        "description": "Creates metadata for an existing Identity-owned Principal. secretReference is an opaque external reference, never secret material.",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCredentialRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/CredentialCreated"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "x-wyrmgate-authority": "Credential authoritative state",
        "x-wyrmgate-administrative-permission": "credential:create",
        "x-wyrmgate-idempotency": "Required"
      }
    },
    "/credentials/{credentialId}": {
      "get": {
        "operationId": "getCredential",
        "summary": "Get Credential metadata",
        "parameters": [
          {
            "$ref": "#/components/parameters/CredentialId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/CredentialResponse"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "x-wyrmgate-authority": "Credential authoritative state",
        "x-wyrmgate-administrative-permission": "credential:read"
      }
    },
    "/credentials/{credentialId}:revoke": {
      "post": {
        "operationId": "revokeCredential",
        "summary": "Authoritatively revoke a Credential",
        "description": "Transitions a revocable Credential to REVOKED. Provider-side residue or revocation execution remains separate.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CredentialId"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/CredentialResponse"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "412": {
            "$ref": "#/components/responses/StaleRevision"
          }
        },
        "x-wyrmgate-authority": "Credential authoritative state",
        "x-wyrmgate-administrative-permission": "credential:revoke",
        "x-wyrmgate-idempotency": "Required"
      }
    },
    "/credentials/{credentialId}:compromise": {
      "post": {
        "operationId": "compromiseCredential",
        "summary": "Mark a Credential compromised",
        "description": "Makes an ACTIVE or SCHEDULED Credential immediately unsafe without waiting for provider-side work.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CredentialId"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/CredentialResponse"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "412": {
            "$ref": "#/components/responses/StaleRevision"
          }
        },
        "x-wyrmgate-authority": "Credential authoritative state",
        "x-wyrmgate-administrative-permission": "credential:compromise",
        "x-wyrmgate-idempotency": "Required"
      }
    },
    "/credentials/{credentialId}:rotate": {
      "post": {
        "operationId": "startCredentialRotation",
        "summary": "Plan routine Credential rotation",
        "description": "Creates a durable PLANNED CredentialRotation for an effective ACTIVE Credential. Internal execution stages are not public mutation operations.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CredentialId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "201": {
            "$ref": "#/components/responses/RotationCreated"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        },
        "x-wyrmgate-authority": "CredentialRotation durable process state",
        "x-wyrmgate-administrative-permission": "credential:rotate",
        "x-wyrmgate-idempotency": "Required"
      }
    },
    "/credentials/{credentialId}/rotations": {
      "get": {
        "operationId": "listCredentialRotations",
        "summary": "List rotations for one old Credential",
        "parameters": [
          {
            "$ref": "#/components/parameters/CredentialId"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/RotationPageResponse"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "x-wyrmgate-authority": "CredentialRotation durable process state",
        "x-wyrmgate-administrative-permission": "credential-rotation:read",
        "x-wyrmgate-pagination": "createdAt descending + id descending; signed tenant/old-Credential-bound cursor"
      }
    },
    "/credential-rotations/{rotationId}": {
      "get": {
        "operationId": "getCredentialRotation",
        "summary": "Get durable Credential rotation state",
        "parameters": [
          {
            "$ref": "#/components/parameters/RotationId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/RotationResponse"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        },
        "x-wyrmgate-authority": "CredentialRotation durable process state",
        "x-wyrmgate-administrative-permission": "credential-rotation:read"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "controlPlaneBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authentication is transport-level only; Administrative Authorization remains separately default-deny."
      }
    },
    "parameters": {
      "PrincipalIdFilter": {
        "name": "principalId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Identity-owned Principal stable ID. The continuation cursor is bound to this Principal."
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Opaque signed tenant/context-bound time-bounded continuation cursor.",
        "schema": {
          "type": "string"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\\\"rev-[1-9][0-9]*\\\"$"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200
        }
      },
      "CorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "CredentialId": {
        "name": "credentialId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "RotationId": {
        "name": "rotationId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "headers": {
      "RevisionEtag": {
        "description": "Strong authoritative revision ETag.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "CredentialCreated": {
        "description": "Credential created",
        "headers": {
          "ETag": {
            "$ref": "#/components/headers/RevisionEtag"
          },
          "Location": {
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CredentialResource"
            }
          }
        }
      },
      "CredentialResponse": {
        "description": "Credential",
        "headers": {
          "ETag": {
            "$ref": "#/components/headers/RevisionEtag"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CredentialResource"
            }
          }
        }
      },
      "CredentialPageResponse": {
        "description": "Credential page",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CredentialPage"
            }
          }
        }
      },
      "RotationCreated": {
        "description": "CredentialRotation planned",
        "headers": {
          "ETag": {
            "$ref": "#/components/headers/RevisionEtag"
          },
          "Location": {
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CredentialRotationResource"
            }
          }
        }
      },
      "RotationResponse": {
        "description": "CredentialRotation",
        "headers": {
          "ETag": {
            "$ref": "#/components/headers/RevisionEtag"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CredentialRotationResource"
            }
          }
        }
      },
      "RotationPageResponse": {
        "description": "CredentialRotation page",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CredentialRotationPage"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Administrative authorization denied",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found in tenant",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Semantic or idempotency conflict",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "StaleRevision": {
        "description": "Stale If-Match revision",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "CredentialKind": {
        "type": "string",
        "enum": [
          "PASSWORD",
          "API_KEY",
          "SSH_KEY",
          "CERTIFICATE",
          "OAUTH_CLIENT_SECRET"
        ]
      },
      "CredentialLifecycleState": {
        "type": "string",
        "enum": [
          "SCHEDULED",
          "ACTIVE",
          "REVOKED",
          "EXPIRED",
          "COMPROMISED"
        ]
      },
      "CredentialRotationState": {
        "type": "string",
        "enum": [
          "PLANNED",
          "CREATING_REPLACEMENT",
          "DISTRIBUTING",
          "VERIFYING",
          "CUTOVER_COMPLETE",
          "REVOKING_OLD",
          "COMPLETED",
          "FAILED",
          "MANUAL_REQUIRED",
          "FAILED_REMEDIATION"
        ]
      },
      "SecretReference": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "providerType",
          "referenceKey"
        ],
        "description": "Opaque external secret-provider reference. This is metadata only and is never dereferenced by this API.",
        "properties": {
          "providerType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "referenceKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "CreateCredentialRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principalId",
          "kind",
          "secretReference",
          "validFrom",
          "validUntil"
        ],
        "properties": {
          "principalId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/CredentialKind"
          },
          "secretReference": {
            "$ref": "#/components/schemas/SecretReference"
          },
          "validFrom": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "validUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "CredentialResource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "principalId",
          "kind",
          "secretReference",
          "lifecycleState",
          "revision",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "principalId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/CredentialKind"
          },
          "secretReference": {
            "$ref": "#/components/schemas/SecretReference"
          },
          "lifecycleState": {
            "$ref": "#/components/schemas/CredentialLifecycleState"
          },
          "validFrom": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "validUntil": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "compromisedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "revokedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "expiredAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "CredentialPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CredentialResource"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CredentialRotationResource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "oldCredentialId",
          "initiatorIdentityId",
          "processState",
          "revision",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "oldCredentialId": {
            "type": "string",
            "format": "uuid"
          },
          "replacementCredentialId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "initiatorIdentityId": {
            "type": "string",
            "format": "uuid"
          },
          "processState": {
            "$ref": "#/components/schemas/CredentialRotationState"
          },
          "checkpoint": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "failureCode": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "CredentialRotationPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CredentialRotationResource"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "FieldError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "code",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "correlationId",
          "fieldErrors"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        }
      }
    }
  },
  "x-wyrmgate-contract-status": "runtime-exposed-authenticated-authorized",
  "x-wyrmgate-secret-boundary": "Only opaque SecretReference metadata is permitted. Raw secret/private material is absent from request and response schemas.",
  "x-wyrmgate-rotation-boundary": "Public v1 plans and reads durable rotation state; provider execution stages remain internal/deferred."
}
