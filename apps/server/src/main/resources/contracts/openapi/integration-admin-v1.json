{
  "openapi": "3.1.0",
  "info": {
    "title": "Wyrmgate IAM Integration Administration API",
    "version": "1.0.0",
    "description": "Integration administration for connectors, bindings, workers, discovery completeness capabilities, and explicit provider-entitlement observation mappings. Mapping provider observations never creates Catalog or Access authority."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/connectors": {
      "post": {
        "operationId": "createConnector",
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/api/v1/connectors/{id}": {
      "get": {
        "operationId": "getConnector",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "patch": {
        "operationId": "updateConnector",
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      }
    },
    "/api/v1/connectors/{id}:disable": {
      "post": {
        "operationId": "disableConnector",
        "responses": {
          "200": {
            "description": "Disabled"
          }
        }
      }
    },
    "/api/v1/connector-bindings": {
      "post": {
        "operationId": "createConnectorBinding",
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/api/v1/connector-bindings/{id}": {
      "get": {
        "operationId": "getConnectorBinding",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "patch": {
        "operationId": "updateConnectorBinding",
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      }
    },
    "/api/v1/connector-bindings/{id}:disable": {
      "post": {
        "operationId": "disableConnectorBinding",
        "responses": {
          "200": {
            "description": "Disabled"
          }
        }
      }
    },
    "/api/v1/connector-workers": {
      "post": {
        "operationId": "createConnectorWorker",
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/api/v1/connector-workers/{id}": {
      "get": {
        "operationId": "getConnectorWorker",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "patch": {
        "operationId": "updateConnectorWorker",
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      }
    },
    "/api/v1/connector-workers/{id}:disable": {
      "post": {
        "operationId": "disableConnectorWorker",
        "responses": {
          "200": {
            "description": "Disabled"
          }
        }
      }
    },
    "/api/v1/connector-bindings/{bindingId}/entitlement-mappings": {
      "post": {
        "operationId": "createEntitlementObservationMapping",
        "parameters": [
          {
            "name": "bindingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 200
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EntitlementMappingCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntitlementMappingResource"
                }
              }
            }
          },
          "400": {
            "description": "Validation failure"
          },
          "403": {
            "description": "Forbidden"
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
    "/api/v1/entitlement-observation-mappings/{id}": {
      "get": {
        "operationId": "getEntitlementObservationMapping",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntitlementMappingResource"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/v1/entitlement-observation-mappings/{id}:unmap": {
      "post": {
        "operationId": "retireEntitlementObservationMapping",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Unmapped",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntitlementMappingResource"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Revision or idempotency conflict"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ConnectorResource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "connectorType",
          "runtimeId",
          "runtimeVersion",
          "configurationVersion",
          "configuration",
          "secretConfigured",
          "lifecycleState",
          "revision",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "connectorType": {
            "type": "string"
          },
          "runtimeId": {
            "type": "string"
          },
          "runtimeVersion": {
            "type": "string"
          },
          "configurationVersion": {
            "type": "integer",
            "minimum": 1
          },
          "configuration": {
            "type": "object"
          },
          "secretConfigured": {
            "type": "boolean"
          },
          "lifecycleState": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED",
              "RETIRED"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ConnectorCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connectorType",
          "runtimeId",
          "runtimeVersion",
          "configurationVersion",
          "configuration"
        ],
        "properties": {
          "connectorType": {
            "type": "string"
          },
          "runtimeId": {
            "type": "string"
          },
          "runtimeVersion": {
            "type": "string"
          },
          "configurationVersion": {
            "type": "integer",
            "minimum": 1
          },
          "configuration": {
            "type": "object"
          },
          "secretReference": {
            "type": [
              "string",
              "null"
            ],
            "writeOnly": true
          }
        }
      },
      "ConnectorBindingResource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "connectorInstanceId",
          "targetKind",
          "targetId",
          "contractId",
          "contractVersion",
          "supportsCompletePrincipalDiscovery",
          "supportsCompleteEntitlementDiscovery",
          "supportsCompleteGrantDiscovery",
          "lifecycleState",
          "revision",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "connectorInstanceId": {
            "type": "string",
            "format": "uuid"
          },
          "targetKind": {
            "type": "string",
            "enum": [
              "APPLICATION_TARGET",
              "SOURCE_SYSTEM"
            ]
          },
          "targetId": {
            "type": "string",
            "format": "uuid"
          },
          "contractId": {
            "type": "string"
          },
          "contractVersion": {
            "type": "integer",
            "minimum": 1
          },
          "supportsCompletePrincipalDiscovery": {
            "type": "boolean"
          },
          "lifecycleState": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "supportsCompleteEntitlementDiscovery": {
            "type": "boolean"
          },
          "supportsCompleteGrantDiscovery": {
            "type": "boolean"
          }
        }
      },
      "ConnectorWorkerResource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "issuer",
          "subject",
          "state",
          "protocolMajorMin",
          "protocolMajorMax",
          "bindingScope",
          "permissions",
          "revision",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "issuer": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "ENABLED",
              "DISABLED"
            ]
          },
          "protocolMajorMin": {
            "type": "integer",
            "minimum": 1
          },
          "protocolMajorMax": {
            "type": "integer",
            "minimum": 1
          },
          "bindingScope": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkerPermission"
            }
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "WorkerPermission": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "runtimeId",
          "runtimeVersion",
          "capability",
          "contractId",
          "contractVersion"
        ],
        "properties": {
          "runtimeId": {
            "type": "string"
          },
          "runtimeVersion": {
            "type": "string"
          },
          "capability": {
            "type": "string",
            "enum": [
              "PROVISION",
              "RECONCILE",
              "SOURCE_DISCOVER",
              "CREDENTIAL_PROVIDER_OPERATION"
            ]
          },
          "contractId": {
            "type": "string"
          },
          "contractVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "EntitlementMappingCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "providerStableId",
          "entitlementId"
        ],
        "properties": {
          "providerStableId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "entitlementId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "EntitlementMappingResource": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "connectorBindingId",
          "providerStableId",
          "entitlementId",
          "lifecycleState",
          "revision",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "connectorBindingId": {
            "type": "string",
            "format": "uuid"
          },
          "providerStableId": {
            "type": "string"
          },
          "entitlementId": {
            "type": "string",
            "format": "uuid"
          },
          "lifecycleState": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "RETIRED"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "retiredAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    }
  },
  "x-wyrmgate-idempotency": "all mutations require Idempotency-Key",
  "x-wyrmgate-concurrency": "updates and disable operations require strong revision If-Match",
  "x-wyrmgate-secret-boundary": "secretReference is write-only; responses expose only secretConfigured; secret-shaped configuration fields are rejected",
  "x-wyrmgate-authorization": "Administration default-deny semantic permissions govern every operation"
}
