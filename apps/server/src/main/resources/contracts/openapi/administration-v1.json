{
  "openapi": "3.1.2",
  "info": {
    "title": "Wyrmgate IAM Administration Authority API",
    "version": "0.1.0",
    "description": "Governed control-plane API for AdministrativeRole, direct AdministrativeGrant, single-hop AdministrativeDelegation, temporary AdministrativeElevation, and emergency AdministrativeBreakGlassOperation under ADR-0032."
  },
  "servers": [{"url": "/api/v1"}],
  "security": [{"controlPlaneBearer": []}],
  "paths": {
    "/administrative-roles": {
      "get": {"operationId":"listAdministrativeRoles","parameters":[{"$ref":"#/components/parameters/Cursor"},{"$ref":"#/components/parameters/Limit"}],"responses":{"200":{"description":"AdministrativeRole page"},"403":{"$ref":"#/components/responses/Forbidden"}}},
      "post": {"operationId":"createAdministrativeRole","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateRoleRequest"}}}},"responses":{"201":{"description":"AdministrativeRole created"},"400":{"$ref":"#/components/responses/Validation"},"403":{"$ref":"#/components/responses/Forbidden"},"409":{"$ref":"#/components/responses/Conflict"}}}
    },
    "/administrative-roles/{roleId}": {
      "get": {"operationId":"getAdministrativeRole","parameters":[{"$ref":"#/components/parameters/RoleId"}],"responses":{"200":{"description":"AdministrativeRole"},"404":{"$ref":"#/components/responses/NotFound"}}},
      "patch": {"operationId":"renameAdministrativeRole","parameters":[{"$ref":"#/components/parameters/RoleId"},{"$ref":"#/components/parameters/IfMatch"},{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string","minLength":1,"maxLength":512}}}}}},"responses":{"200":{"description":"AdministrativeRole renamed"},"412":{"$ref":"#/components/responses/Stale"}}}
    },
    "/administrative-roles/{roleId}:add-permission": {
      "post": {"operationId":"addAdministrativeRolePermission","parameters":[{"$ref":"#/components/parameters/RoleId"},{"$ref":"#/components/parameters/IfMatch"},{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"$ref":"#/components/requestBodies/PermissionMutation"},"responses":{"200":{"description":"Permission added"},"403":{"$ref":"#/components/responses/Forbidden"},"412":{"$ref":"#/components/responses/Stale"}}}
    },
    "/administrative-roles/{roleId}:remove-permission": {
      "post": {"operationId":"removeAdministrativeRolePermission","parameters":[{"$ref":"#/components/parameters/RoleId"},{"$ref":"#/components/parameters/IfMatch"},{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"$ref":"#/components/requestBodies/PermissionMutation"},"responses":{"200":{"description":"Permission removed"},"412":{"$ref":"#/components/responses/Stale"}}}
    },
    "/administrative-grants": {
      "get": {"operationId":"listAdministrativeGrants","parameters":[{"$ref":"#/components/parameters/Cursor"},{"$ref":"#/components/parameters/Limit"}],"responses":{"200":{"description":"AdministrativeGrant page"}}},
      "post": {"operationId":"createAdministrativeGrant","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateGrantRequest"}}}},"responses":{"201":{"description":"AdministrativeGrant created"},"403":{"$ref":"#/components/responses/Forbidden"},"409":{"$ref":"#/components/responses/Conflict"}}}
    },
    "/administrative-grants/{grantId}": {
      "get": {"operationId":"getAdministrativeGrant","parameters":[{"$ref":"#/components/parameters/GrantId"}],"responses":{"200":{"description":"AdministrativeGrant"},"404":{"$ref":"#/components/responses/NotFound"}}}
    },
    "/administrative-grants/{grantId}:revoke": {
      "post": {"operationId":"revokeAdministrativeGrant","parameters":[{"$ref":"#/components/parameters/GrantId"},{"$ref":"#/components/parameters/IfMatch"},{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"200":{"description":"AdministrativeGrant revoked"},"412":{"$ref":"#/components/responses/Stale"}}}
    },
    "/administrative-delegations": {
      "get": {"operationId":"listAdministrativeDelegations","parameters":[{"$ref":"#/components/parameters/Cursor"},{"$ref":"#/components/parameters/Limit"}],"responses":{"200":{"description":"AdministrativeDelegation page"}}},
      "post": {"operationId":"createAdministrativeDelegation","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateDelegationRequest"}}}},"responses":{"201":{"description":"AdministrativeDelegation created"},"403":{"$ref":"#/components/responses/Forbidden"}}}
    },
    "/administrative-delegations/{delegationId}": {
      "get": {"operationId":"getAdministrativeDelegation","parameters":[{"$ref":"#/components/parameters/DelegationId"}],"responses":{"200":{"description":"AdministrativeDelegation"},"404":{"$ref":"#/components/responses/NotFound"}}}
    },
    "/administrative-delegations/{delegationId}:revoke": {
      "post": {"operationId":"revokeAdministrativeDelegation","parameters":[{"$ref":"#/components/parameters/DelegationId"},{"$ref":"#/components/parameters/IfMatch"},{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"200":{"description":"AdministrativeDelegation revoked"},"412":{"$ref":"#/components/responses/Stale"}}}
    },
    "/administrative-elevations": {
      "get": {"operationId":"listAdministrativeElevations","parameters":[{"$ref":"#/components/parameters/Cursor"},{"$ref":"#/components/parameters/Limit"}],"responses":{"200":{"description":"AdministrativeElevation page"}}},
      "post": {"operationId":"requestAdministrativeElevation","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateElevationRequest"}}}},"responses":{"201":{"description":"AdministrativeElevation requested"},"403":{"$ref":"#/components/responses/Forbidden"}}}
    },
    "/administrative-elevations/{elevationId}": {
      "get": {"operationId":"getAdministrativeElevation","parameters":[{"$ref":"#/components/parameters/ElevationId"}],"responses":{"200":{"description":"AdministrativeElevation"},"404":{"$ref":"#/components/responses/NotFound"}}}
    },
    "/administrative-elevations/{elevationId}:request-approval": {"post":{"operationId":"requestAdministrativeElevationApproval","parameters":[{"$ref":"#/components/parameters/ElevationId"},{"$ref":"#/components/parameters/IfMatch"},{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"200":{"description":"Approval requested"},"409":{"$ref":"#/components/responses/Conflict"},"412":{"$ref":"#/components/responses/Stale"}}}},
    "/administrative-elevations/{elevationId}:apply": {"post":{"operationId":"applyAdministrativeElevation","parameters":[{"$ref":"#/components/parameters/ElevationId"},{"$ref":"#/components/parameters/IfMatch"},{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"200":{"description":"Approval result applied"},"409":{"$ref":"#/components/responses/Conflict"},"412":{"$ref":"#/components/responses/Stale"}}}},
    "/administrative-elevations/{elevationId}:cancel": {"post":{"operationId":"cancelAdministrativeElevation","parameters":[{"$ref":"#/components/parameters/ElevationId"},{"$ref":"#/components/parameters/IfMatch"},{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"200":{"description":"Elevation cancelled"},"409":{"$ref":"#/components/responses/Conflict"},"412":{"$ref":"#/components/responses/Stale"}}}},
    "/administrative-elevations/{elevationId}:revoke": {"post":{"operationId":"revokeAdministrativeElevation","parameters":[{"$ref":"#/components/parameters/ElevationId"},{"$ref":"#/components/parameters/IfMatch"},{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"200":{"description":"Elevation revoked"},"412":{"$ref":"#/components/responses/Stale"}}}},
    "/administrative-break-glass-operations": {
      "get": {"operationId":"listAdministrativeBreakGlassOperations","parameters":[{"$ref":"#/components/parameters/Cursor"},{"$ref":"#/components/parameters/Limit"}],"responses":{"200":{"description":"AdministrativeBreakGlassOperation page"}}},
      "post": {"operationId":"activateAdministrativeBreakGlass","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ActivateBreakGlassRequest"}}}},"responses":{"201":{"description":"Break-glass activated"},"403":{"$ref":"#/components/responses/Forbidden"},"503":{"$ref":"#/components/responses/Unavailable"}}}
    },
    "/administrative-break-glass-operations/{operationId}": {
      "get": {"operationId":"getAdministrativeBreakGlassOperation","parameters":[{"$ref":"#/components/parameters/BreakGlassId"}],"responses":{"200":{"description":"AdministrativeBreakGlassOperation"},"404":{"$ref":"#/components/responses/NotFound"}}}
    },
    "/administrative-break-glass-operations/{operationId}:revoke": {
      "post": {"operationId":"revokeAdministrativeBreakGlass","parameters":[{"$ref":"#/components/parameters/BreakGlassId"},{"$ref":"#/components/parameters/IfMatch"},{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"200":{"description":"Break-glass revoked"},"412":{"$ref":"#/components/responses/Stale"}}}
    }
  },
  "components": {
    "securitySchemes": {"controlPlaneBearer":{"type":"http","scheme":"bearer","bearerFormat":"JWT"}},
    "parameters": {
      "Cursor":{"name":"cursor","in":"query","required":false,"schema":{"type":"string"}},
      "Limit":{"name":"limit","in":"query","required":false,"schema":{"type":"integer","minimum":1,"maximum":200,"default":50}},
      "IfMatch":{"name":"If-Match","in":"header","required":true,"schema":{"type":"string"}},
      "IdempotencyKey":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":8,"maxLength":200}},
      "RoleId":{"name":"roleId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "GrantId":{"name":"grantId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "DelegationId":{"name":"delegationId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "ElevationId":{"name":"elevationId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "BreakGlassId":{"name":"operationId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}
    },
    "requestBodies": {
      "PermissionMutation":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["permission"],"properties":{"permission":{"type":"string","pattern":"^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$"}}}}}}
    },
    "responses": {
      "Validation":{"description":"Validation failed"},
      "Forbidden":{"description":"Administrative authorization denied"},
      "NotFound":{"description":"Resource not found in tenant"},
      "Conflict":{"description":"Semantic or idempotency conflict"},
      "Stale":{"description":"Stale If-Match revision"},
      "Unavailable":{"description":"Mandatory evaluator or policy unavailable"}
    },
    "schemas": {
      "Scope":{"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"type":"string","enum":["GLOBAL","ORGANIZATION","APPLICATION","APPLICATION_TARGET","SOURCE_SYSTEM","CONNECTOR_INSTANCE","IDENTITY_POPULATION","CANONICAL_ATTRIBUTE_CLASSIFICATION","SPECIFIC_RESOURCE"]},"resourceType":{"type":["string","null"]},"resourceId":{"type":["string","null"],"format":"uuid"},"scopeKey":{"type":["string","null"]}}},
      "CreateRoleRequest":{"type":"object","additionalProperties":false,"required":["code","name","permissions"],"properties":{"code":{"type":"string","minLength":1,"maxLength":128},"name":{"type":"string","minLength":1,"maxLength":512},"permissions":{"type":"array","minItems":1,"maxItems":200,"uniqueItems":true,"items":{"type":"string"}}}},
      "CreateGrantRequest":{"type":"object","additionalProperties":false,"required":["beneficiaryIdentityId","roleId","scope","grantable","delegable","authorityBasisGrantId"],"properties":{"beneficiaryIdentityId":{"type":"string","format":"uuid"},"roleId":{"type":"string","format":"uuid"},"scope":{"$ref":"#/components/schemas/Scope"},"validFrom":{"type":["string","null"],"format":"date-time"},"validUntil":{"type":["string","null"],"format":"date-time"},"grantable":{"type":"boolean"},"delegable":{"type":"boolean"},"authorityBasisGrantId":{"type":"string","format":"uuid"}}},
      "CreateDelegationRequest":{"type":"object","additionalProperties":false,"required":["delegateIdentityId","sourceGrantId","scope","validUntil"],"properties":{"delegateIdentityId":{"type":"string","format":"uuid"},"sourceGrantId":{"type":"string","format":"uuid"},"scope":{"$ref":"#/components/schemas/Scope"},"validFrom":{"type":["string","null"],"format":"date-time"},"validUntil":{"type":"string","format":"date-time"}}},
      "CreateElevationRequest":{"type":"object","additionalProperties":false,"required":["beneficiaryIdentityId","roleId","scope","validUntil","authorityBasisGrantId"],"properties":{"beneficiaryIdentityId":{"type":"string","format":"uuid"},"roleId":{"type":"string","format":"uuid"},"scope":{"$ref":"#/components/schemas/Scope"},"validFrom":{"type":["string","null"],"format":"date-time"},"validUntil":{"type":"string","format":"date-time"},"authorityBasisGrantId":{"type":"string","format":"uuid"}}},
      "ActivateBreakGlassRequest":{"type":"object","additionalProperties":false,"required":["roleId","scope","validUntil","reason","incidentReference"],"properties":{"roleId":{"type":"string","format":"uuid"},"scope":{"$ref":"#/components/schemas/Scope"},"validUntil":{"type":"string","format":"date-time"},"reason":{"type":"string","minLength":1,"maxLength":2048},"incidentReference":{"type":"string","minLength":1,"maxLength":512}}}
    }
  },
  "x-wyrmgate-authority-boundary": "Administration owns all resources exposed by this contract. Governance approval is evidence only and never mutates Administration persistence.",
  "x-wyrmgate-temporal-validity": "Grant, delegation, elevation and break-glass validity is evaluated semantically from time; scheduler delay never extends authority.",
  "x-wyrmgate-audit": "Public security-significant mutations append data-minimized SUCCESS, DENIED or FAILURE AuditRecord evidence outside the authoritative transaction."
}
