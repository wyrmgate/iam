{
  "openapi": "3.1.2",
  "info": {
    "title": "Wyrmgate IAM Audit API",
    "version": "0.2.0",
    "description": "Bounded tenant-scoped AuditRecord read/search plus durable ADR-0034 Audit export operations."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "controlPlaneBearer": []
    }
  ],
  "x-wyrmgate-contract-status": "runtime-exposed-authenticated-authorized",
  "paths": {
    "/audit-records": {
      "get": {
        "operationId": "listAuditRecords",
        "summary": "Search audit records",
        "x-wyrmgate-administrative-permission": "audit:read",
        "parameters": [
          {
            "$ref": "#/components/parameters/ActorId"
          },
          {
            "$ref": "#/components/parameters/ActionType"
          },
          {
            "$ref": "#/components/parameters/ResourceType"
          },
          {
            "$ref": "#/components/parameters/ResourceId"
          },
          {
            "$ref": "#/components/parameters/Outcome"
          },
          {
            "$ref": "#/components/parameters/CorrelationIdFilter"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded AuditRecord page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditRecordPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/audit-records/{auditRecordId}": {
      "get": {
        "operationId": "getAuditRecord",
        "summary": "Read one audit record",
        "x-wyrmgate-administrative-permission": "audit:read",
        "parameters": [
          {
            "$ref": "#/components/parameters/AuditRecordId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "AuditRecord",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditRecord"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/audit-exports": {
      "post": {
        "operationId": "createAuditExport",
        "summary": "Request a durable audit export",
        "x-wyrmgate-administrative-permission": "audit:export",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditExportCreateRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Audit export accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditExport"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/audit-exports/{auditExportId}": {
      "get": {
        "operationId": "getAuditExport",
        "summary": "Read one durable audit export operation",
        "x-wyrmgate-administrative-permission": "audit:export",
        "parameters": [
          {
            "$ref": "#/components/parameters/AuditExportId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Audit export operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditExport"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/audit-exports/{auditExportId}:download": {
      "post": {
        "operationId": "downloadAuditExport",
        "summary": "Download a completed audit export artifact",
        "x-wyrmgate-administrative-permission": "audit:export",
        "parameters": [
          {
            "$ref": "#/components/parameters/AuditExportId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Closed UTF-8 NDJSON v1 artifact",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "410": {
            "$ref": "#/components/responses/Gone"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "controlPlaneBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "AuditRecordId": {
        "name": "auditRecordId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ActorId": {
        "name": "actorId",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ActionType": {
        "name": "actionType",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "ResourceType": {
        "name": "resourceType",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "ResourceId": {
        "name": "resourceId",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Outcome": {
        "name": "outcome",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "SUCCESS",
            "DENIED",
            "FAILURE"
          ]
        }
      },
      "CorrelationIdFilter": {
        "name": "correlationId",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      },
      "CorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "AuditExportId": {
        "name": "auditExportId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "AuthenticationRequired": {
        "description": "Authentication required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Administrative authorization denied",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "AuditRecord not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Request conflicts with current durable operation state",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Gone": {
        "description": "Requested export artifact has expired",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Audit export is not enabled for this deployment",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "AuditRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "occurredAt",
          "recordedAt",
          "actionType",
          "resourceType",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "actorId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "actionType": {
            "type": "string",
            "maxLength": 128
          },
          "resourceType": {
            "type": "string",
            "maxLength": 128
          },
          "resourceId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "DENIED",
              "FAILURE"
            ]
          },
          "correlationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "causationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "AuditRecordPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditRecord"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "FieldError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "code",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "correlationId",
          "fieldErrors"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        }
      },
      "AuditExportCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "occurredFrom",
          "occurredUntil"
        ],
        "properties": {
          "actorId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "actionType": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128
          },
          "resourceType": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 128
          },
          "resourceId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "SUCCESS",
              "DENIED",
              "FAILURE",
              null
            ]
          },
          "correlationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "occurredFrom": {
            "type": "string",
            "format": "date-time"
          },
          "occurredUntil": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuditExport": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requestedByIdentityId",
          "occurredFrom",
          "occurredUntil",
          "snapshotRecordedAt",
          "schemaVersion",
          "state",
          "recordCount",
          "byteCount",
          "revision",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "requestedByIdentityId": {
            "type": "string",
            "format": "uuid"
          },
          "actorId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "actionType": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "resourceType": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "resourceId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "SUCCESS",
              "DENIED",
              "FAILURE",
              null
            ]
          },
          "correlationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "occurredFrom": {
            "type": "string",
            "format": "date-time"
          },
          "occurredUntil": {
            "type": "string",
            "format": "date-time"
          },
          "snapshotRecordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "schemaVersion": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "REQUESTED",
              "RUNNING",
              "SUCCEEDED",
              "FAILED"
            ]
          },
          "recordCount": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "byteCount": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "artifactExpiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "failureCode": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
