{
  "openapi": "3.1.2",
  "info": {
    "title": "Wyrmgate IAM Audit API",
    "version": "0.3.0",
    "description": "Bounded tenant-scoped AuditRecord read/search, durable export/archive-aware evidence reads, EvidenceSnapshot reads, and governed legal-hold/purge operations."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "security": [
    {
      "controlPlaneBearer": []
    }
  ],
  "x-wyrmgate-contract-status": "runtime-exposed-authenticated-authorized",
  "paths": {
    "/audit-records": {
      "get": {
        "operationId": "listAuditRecords",
        "summary": "Search audit records",
        "x-wyrmgate-administrative-permission": "audit:read",
        "parameters": [
          {
            "$ref": "#/components/parameters/ActorId"
          },
          {
            "$ref": "#/components/parameters/ActionType"
          },
          {
            "$ref": "#/components/parameters/ResourceType"
          },
          {
            "$ref": "#/components/parameters/ResourceId"
          },
          {
            "$ref": "#/components/parameters/Outcome"
          },
          {
            "$ref": "#/components/parameters/CorrelationIdFilter"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded AuditRecord page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditRecordPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/audit-records/{auditRecordId}": {
      "get": {
        "operationId": "getAuditRecord",
        "summary": "Read one audit record",
        "x-wyrmgate-administrative-permission": "audit:read",
        "parameters": [
          {
            "$ref": "#/components/parameters/AuditRecordId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "AuditRecord",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditRecord"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/audit-exports": {
      "post": {
        "operationId": "createAuditExport",
        "summary": "Request a durable audit export",
        "x-wyrmgate-administrative-permission": "audit:export",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditExportCreateRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Audit export accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditExport"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/audit-exports/{auditExportId}": {
      "get": {
        "operationId": "getAuditExport",
        "summary": "Read one durable audit export operation",
        "x-wyrmgate-administrative-permission": "audit:export",
        "parameters": [
          {
            "$ref": "#/components/parameters/AuditExportId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Audit export operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditExport"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/audit-exports/{auditExportId}:download": {
      "post": {
        "operationId": "downloadAuditExport",
        "summary": "Download a completed audit export artifact",
        "x-wyrmgate-administrative-permission": "audit:export",
        "parameters": [
          {
            "$ref": "#/components/parameters/AuditExportId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Closed UTF-8 NDJSON v1 artifact",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "410": {
            "$ref": "#/components/responses/Gone"
          }
        }
      }
    },
    "/evidence-snapshots": {
      "get": {
        "operationId": "listEvidenceSnapshots",
        "summary": "Search immutable EvidenceSnapshots",
        "x-wyrmgate-administrative-permission": "evidence-snapshot:read",
        "parameters": [
          {
            "name": "snapshotType",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          },
          {
            "name": "subjectResourceType",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "subjectResourceId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "correlationId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded EvidenceSnapshot page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceSnapshotPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/evidence-snapshots/{evidenceSnapshotId}": {
      "get": {
        "operationId": "getEvidenceSnapshot",
        "summary": "Read one immutable EvidenceSnapshot",
        "x-wyrmgate-administrative-permission": "evidence-snapshot:read",
        "parameters": [
          {
            "$ref": "#/components/parameters/EvidenceSnapshotId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "EvidenceSnapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidenceSnapshot"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/audit-evidence-lifecycle/legal-holds": {
      "post": {
        "operationId": "createAuditLegalHold",
        "summary": "Create an Audit legal hold",
        "x-wyrmgate-administrative-permission": "audit:hold",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditLegalHoldCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Legal hold created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditLegalHold"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/audit-evidence-lifecycle/legal-holds/{holdId}": {
      "get": {
        "operationId": "getAuditLegalHold",
        "summary": "Read one Audit legal hold",
        "x-wyrmgate-administrative-permission": "audit:hold",
        "parameters": [
          {
            "$ref": "#/components/parameters/AuditLegalHoldId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Legal hold",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditLegalHold"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/audit-evidence-lifecycle/legal-holds/{holdId}:release": {
      "post": {
        "operationId": "releaseAuditLegalHold",
        "summary": "Release an active Audit legal hold",
        "x-wyrmgate-administrative-permission": "audit:hold",
        "parameters": [
          {
            "$ref": "#/components/parameters/AuditLegalHoldId"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Released legal hold",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditLegalHold"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/audit-evidence-lifecycle/purges": {
      "post": {
        "operationId": "createAuditPurge",
        "summary": "Request a governed destructive Audit purge",
        "x-wyrmgate-administrative-permission": "audit:purge",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuditPurgeCreateRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Purge request accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPurgeOperation"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/audit-evidence-lifecycle/purges/{purgeId}": {
      "get": {
        "operationId": "getAuditPurge",
        "summary": "Read one Audit purge operation",
        "x-wyrmgate-administrative-permission": "audit:purge",
        "parameters": [
          {
            "$ref": "#/components/parameters/AuditPurgeId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "Purge operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPurgeOperation"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/audit-evidence-lifecycle/purges/{purgeId}:approve": {
      "post": {
        "operationId": "approveAuditPurge",
        "summary": "Approve a purge requested by a different governed Identity",
        "x-wyrmgate-administrative-permission": "audit:purge",
        "parameters": [
          {
            "$ref": "#/components/parameters/AuditPurgeId"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "202": {
            "description": "Purge approved for asynchronous execution",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPurgeOperation"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "controlPlaneBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "AuditRecordId": {
        "name": "auditRecordId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ActorId": {
        "name": "actorId",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ActionType": {
        "name": "actionType",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "ResourceType": {
        "name": "resourceType",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "ResourceId": {
        "name": "resourceId",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Outcome": {
        "name": "outcome",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "SUCCESS",
            "DENIED",
            "FAILURE"
          ]
        }
      },
      "CorrelationIdFilter": {
        "name": "correlationId",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      },
      "CorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "AuditExportId": {
        "name": "auditExportId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "Current optimistic revision ETag, for example \"rev-2\".",
        "schema": {
          "type": "string",
          "pattern": "^\"rev-[1-9][0-9]*\"$"
        }
      },
      "EvidenceSnapshotId": {
        "name": "evidenceSnapshotId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "AuditLegalHoldId": {
        "name": "holdId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "AuditPurgeId": {
        "name": "purgeId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Validation failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "AuthenticationRequired": {
        "description": "Authentication required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Administrative authorization denied",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFound": {
        "description": "AuditRecord not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Conflict": {
        "description": "Request conflicts with current durable operation state",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Gone": {
        "description": "Requested export artifact has expired",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Audit export is not enabled for this deployment",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "AuditRecord": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "occurredAt",
          "recordedAt",
          "actionType",
          "resourceType",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "actorId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "actionType": {
            "type": "string",
            "maxLength": 128
          },
          "resourceType": {
            "type": "string",
            "maxLength": 128
          },
          "resourceId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "DENIED",
              "FAILURE"
            ]
          },
          "correlationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "causationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "materialSnapshot": {
            "$ref": "#/components/schemas/AuditMaterialSnapshot"
          },
          "integrityMetadata": {
            "$ref": "#/components/schemas/AuditIntegrityMetadata"
          }
        }
      },
      "AuditRecordPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditRecord"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "FieldError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "code",
          "message"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "correlationId",
          "fieldErrors"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "fieldErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          }
        }
      },
      "AuditExportCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "occurredFrom",
