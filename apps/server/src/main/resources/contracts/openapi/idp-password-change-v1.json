{
  "openapi": "3.1.2",
  "info": {
    "title": "Wyrmgate IAM first-party password change",
    "version": "0.1.0",
    "description": "Dedicated self-service authenticator input, not an ordinary Credential resource API."
  },
  "servers": [
    {
      "url": "/api/auth"
    }
  ],
  "security": [
    {
      "browserSession": [],
      "csrfHeader": [],
      "csrfCookie": []
    }
  ],
  "paths": {
    "/password/change": {
      "post": {
        "operationId": "changeLocalPassword",
        "summary": "Atomically change the current first-party local authenticator",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "currentPassword",
                  "newPassword"
                ],
                "properties": {
                  "currentPassword": {
                    "type": "string",
                    "minLength": 1,
                    "writeOnly": true
                  },
                  "newPassword": {
                    "type": "string",
                    "minLength": 15,
                    "maxLength": 1024,
                    "writeOnly": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Change completed; sign in again. Session and CSRF cookies cleared."
          },
          "400": {
            "description": "Normalized error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Normalized error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "403": {
            "description": "Normalized error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "503": {
            "description": "Normalized error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ],
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "x-wyrmgate-authority": "Current first-party browser session plus exact local authenticator reproof",
        "x-wyrmgate-retry": "Exact old credential revision fences duplicates; sign in again after uncertain response."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-wyrmgate_sso"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Wyrmgate-CSRF"
      },
      "csrfCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-wyrmgate_csrf"
      }
    }
  }
}
