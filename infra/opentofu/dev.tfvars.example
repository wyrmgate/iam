# DEV planning example. Copy to dev.tfvars and replace every placeholder before planning.
# dev.tfvars is ignored. Never commit real OCIDs, keys, administrator IPs, or state.

region              = "ap-singapore-1"
compartment_ocid    = "ocid1.compartment.oc1..replace-me"
availability_domain = "replace-with-region-availability-domain"
image_ocid           = "ocid1.image.oc1.ap-singapore-1.replace-me"
admin_cidr           = "203.0.113.10/32"
ssh_public_key       = "ssh-ed25519 AAAA... operator@example"

name_prefix    = "wyrmgate-iam-dev"
vcn_dns_label  = "iamdev"
hostname_label = "iamdev"

# Review shape/capacity in the selected OCI region before apply.
instance_shape     = "VM.Standard.A1.Flex"
instance_ocpus     = 1
instance_memory_gb = 6
