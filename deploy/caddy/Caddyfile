{
  email {$IAM_ACME_EMAIL}
  admin off
}

{$IAM_PUBLIC_HOST} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }

  @server path /api/* /actuator/health /actuator/health/*
  reverse_proxy @server {$IAM_SERVER_UPSTREAM:iam-server:8080}

  reverse_proxy {$IAM_CONSOLE_UPSTREAM:iam-console:8080}
}
