# Wyrmgate IAM local-development defaults only.
# Copy to deploy/config/local.env with `make dev-init`.
# Never reuse these values outside a developer machine.

IAM_DB_NAME=wyrmgate_iam
IAM_DB_USER=wyrmgate
IAM_DB_PASSWORD=wyrmgate_local_dev
IAM_DB_PORT=5432
IAM_DB_URL=jdbc:postgresql://localhost:5432/wyrmgate_iam

IAM_VALKEY_PORT=6379

IAM_MAILPIT_SMTP_PORT=1025
IAM_MAILPIT_UI_PORT=8025

IAM_OTEL_GRPC_PORT=4317
IAM_OTEL_HTTP_PORT=4318
IAM_OTEL_HEALTH_PORT=13133
