# DEV runtime configuration. Copy to dev.env only on the target host.
# Never commit deploy/config/dev.env.

IAM_PUBLIC_HOST=iam-dev.example.com
IAM_DB_NAME=wyrmgate_iam
IAM_DB_USER=wyrmgate
IAM_DB_PASSWORD=replace-me

# Immutable images produced by Container CI on main.
IAM_SERVER_IMAGE=ghcr.io/wyrmgate/iam-server:sha-replace-me
IAM_CONSOLE_IMAGE=ghcr.io/wyrmgate/iam-console:sha-replace-me

# Collector -> observability backend. Endpoint is the OTLP/HTTP base endpoint.
IAM_OTEL_EXPORTER_ENDPOINT=https://otlp.example.com
IAM_OTEL_EXPORTER_AUTHORIZATION=replace-me
IAM_TRACE_SAMPLING_PROBABILITY=0.10
